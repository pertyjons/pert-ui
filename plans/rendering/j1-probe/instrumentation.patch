new file mode 100644
index 0000000..2484064
--- /dev/null
+++ b/crates/pert-ui-runtime/src/j1.rs
@@ -0,0 +1,81 @@
+//! Throwaway J1 instrumentation (not shipped).
+#![allow(missing_docs, missing_debug_implementations, clippy::missing_panics_doc)]
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::time::{Duration, Instant};
+
+thread_local! {
+    static TIMES: RefCell<BTreeMap<&'static str, (Duration, u64)>> = RefCell::new(BTreeMap::new());
+    static ON: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+pub fn flag(name: &str) -> bool {
+    static FLAGS: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    FLAGS
+        .get_or_init(|| std::env::var("J1_FLAGS").unwrap_or_default())
+        .split(',')
+        .any(|f| f == name)
+}
+
+pub fn enable(on: bool) {
+    ON.with(|o| o.set(on));
+}
+
+pub fn on() -> bool {
+    ON.with(|o| o.get())
+}
+
+pub struct Guard(&'static str, Option<Instant>);
+impl Drop for Guard {
+    fn drop(&mut self) {
+        if let Some(start) = self.1 {
+            let d = start.elapsed();
+            TIMES.with(|t| {
+                let mut t = t.borrow_mut();
+                let e = t.entry(self.0).or_default();
+                e.0 += d;
+                e.1 += 1;
+            });
+        }
+    }
+}
+#[must_use]
+pub fn time(name: &'static str) -> Guard {
+    Guard(name, ON.with(|o| o.get()).then(Instant::now))
+}
+pub fn count(name: &'static str, n: u64) {
+    if !ON.with(|o| o.get()) {
+        return;
+    }
+    TIMES.with(|t| {
+        let mut t = t.borrow_mut();
+        t.entry(name).or_default().1 += n;
+    });
+}
+thread_local! {
+    static SETS: RefCell<BTreeMap<&'static str, std::collections::HashSet<u64>>> = RefCell::new(BTreeMap::new());
+}
+pub fn distinct(name: &'static str, key: u64) {
+    if !on() {
+        return;
+    }
+    SETS.with(|s| {
+        s.borrow_mut().entry(name).or_default().insert(key);
+    });
+}
+pub fn take_distinct() -> Vec<(&'static str, usize)> {
+    SETS.with(|s| {
+        std::mem::take(&mut *s.borrow_mut())
+            .into_iter()
+            .map(|(k, v)| (k, v.len()))
+            .collect()
+    })
+}
+pub fn take() -> Vec<(&'static str, Duration, u64)> {
+    TIMES.with(|t| {
+        std::mem::take(&mut *t.borrow_mut())
+            .into_iter()
+            .map(|(k, (d, n))| (k, d, n))
+            .collect()
+    })
+}
